{
  "schemaVersion": "shotpilot-design-system/v1",
  "finish": {
    "grade": "none",
    "letterbox": 0,
    "typeface": "gothic"
  },
  "palette": {
    "ink": "#111022",
    "paper": "#fafaf0",
    "accent": "#ffcc33"
  },
  "type": {
    "display": "DotGothic16:400",
    "body": "DotGothic16:400",
    "latin": "Pixelify Sans:500",
    "title_size": 0.14
  },
  "cards": {
    "card_hold": 1.8,
    "title_hold": 2.8,
    "black": 0.4,
    "max_ja": 8,
    "max_en": 4
  },
  "transitions": {
    "default": "cut",
    "accent": "flash"
  },
  "camera": {
    "focal": [
      35,
      50
    ],
    "moves": [
      "static",
      "truck_left",
      "truck_right"
    ],
    "shot_seconds": [
      1.5,
      2.5
    ]
  },
  "motion": {
    "profile": "action",
    "caption": {
      "in": "type"
    },
    "title": {
      "in": "flicker",
      "in_s": 0.5
    }
  }
}
