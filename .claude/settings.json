{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "bashOutputMaxChars": 12000,
  "disableAgentView": true,
  "env": {
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(shotpilot *)",
      "Bash(python -m shotpilot *)",
      "Bash(pip install -e *)",
      "Bash(ffprobe *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(UnrealEditor-Cmd *)",
      "Bash(UnrealEditor *)"
    ],
    "deny": [
      "Edit(./.git/**)",
      "Edit(./render/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
